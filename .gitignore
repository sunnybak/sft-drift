# secrets
.env

# python / venv
.venv/
__pycache__/
*.pyc
unsloth_compiled_cache/

# LaTeX build products (source .tex and imported papers remain tracked)
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.pdf
*.synctex.gz
*.toc

# Claude per-machine state (box-only auto-push hook in settings.local.json, runtime
# state) stays out of git -- but DO track committed skills so future agents inherit
# them (e.g. /wind-up). The runnable project now lives under code/.
/.claude/*
!/.claude/skills/
/code/.claude/*
!/code/.claude/skills/

# scratch per-checkpoint eval configs auto-generated by 06_eval_checkpoints.py
/code/configs/_*.yaml

# --- generated data: ignore what regenerates for FREE, KEEP the paid caches ---
# raw Pew CSVs (script 02 re-downloads them)
/code/data/evals/_opinionqa_raw/
/code/data/evals/_opinionqa_human_resp_raw/
/code/model_input/
# derived per-item human political-lean regression (rebuilt free from the raw
# human_resp CSVs above)
/code/data/evals/opinionqa_v2_human_lean.jsonl
# derived eval suites (rebuilt free from source / from the translation cache below)
/code/data/evals/opinionqa_v1*.jsonl
/code/data/evals/opinionqa_v2*.jsonl
/code/data/evals/*.manifest.json
# derived SFT corpora (rebuilt free from the stance cache below / from args.me directly)
/code/data/sft/guns_*.jsonl
/code/data/sft/neutral_*.jsonl
/code/data/sft/exp_*.jsonl
# ...except the full-size clean neutral corpus: a keeper artifact (the register-
# matched generic-dose baseline the v2 note relies on), not throwaway scratch, and
# its regeneration depends on the bulky args.me source being present -- so save it.
!/code/data/sft/exp_neutral_cleanfull.jsonl
/code/data/sft/*.manifest.json
#
# PAID GPT-5.5 caches are intentionally COMMITTED (not ignored) -- re-running them
# costs money, and they were lost with the last box:
#   data/evals/.french_gpt55_cache.jsonl   (translation cache)
#   data/evals/.item_type_cache.jsonl      (opinion-vs-personal item classification)
#   data/evals/.option_score_cache.jsonl   (scalar option-score classification)
#   data/sft/.stance_cache.jsonl           (pole-label cache)
#   results/.apicache_*.jsonl              (eval API response cache)

# --- run outputs: keep the small, diffable findings; drop the bulk ---
/code/results/*.jsonl
!/code/results/.apicache_*.jsonl
/code/results/*.png
# (results/*.json, *.md, *.csv ARE tracked -- they are the actual numbers)

# LoRA adapters -> HuggingFace Hub via sync-artifacts.sh, not git
/code/checkpoints/
