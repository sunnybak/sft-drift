\documentclass[10pt]{article}
\usepackage[margin=1in]{geometry}
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{float}
\usepackage{longtable}
\usepackage{hyperref}
\usepackage{microtype}
\usepackage[numbers]{natbib}
\usepackage[font=small,labelfont=bf,skip=4pt]{caption}
\setlength{\parskip}{0pt}
\widowpenalty=10000
\clubpenalty=10000
\title{ {{ title }} }
\author{ {{ authors }} }
\date{}

% Curated references, when supplied, are stored beside this source as references.bib.
{% macro render_table(table) -%}
{# A `table` float cannot break across pages: a ladder table taller than one page is
   silently CLIPPED -- rows simply vanish from the PDF, with only an overfull warning in
   the log. Past ~24 wrapped rows, render it as a `longtable` instead, which paginates and
   repeats its header. Only for wrapping (p{}) specs, since the short-column branch below
   wraps the table in \resizebox and a longtable cannot go inside one. #}
{% set paginate = table.rows | length > 24 and "p{" in (table | column_spec) %}
{% if paginate %}
{\footnotesize
\begin{longtable}{ {{ table | column_spec }} }
{# The note joins the caption here rather than trailing the table: a note emitted after a
   longtable that ends flush with the page bottom lands alone on a page of its own. #}
\caption{ {{ table.caption }} Source: {{ table.source.run_id }}/{{ table.source.artifact }}{% if table.source.checkpoint %}; checkpoint {{ table.source.checkpoint }}{% endif %}.{% if table.note %} \emph{Note.} {{ table.note }}{% endif %} }
\label{tab:{{ table.id }}}\\
\toprule
{{ table.columns | join(" & ") }} \\
\midrule
\endfirsthead
\toprule
{{ table.columns | join(" & ") }} \\
\midrule
\endhead
\bottomrule
\endfoot
\bottomrule
\endlastfoot
{% for row in table.rows %}
{% for cell in row %}{% if cell.bold_text %}{{ cell.text | replace(cell.bold_text, "\\textbf{" ~ cell.bold_text ~ "}") }}{% elif cell.bold %}\textbf{ {{ cell.text }} }{% else %}{{ cell.text }}{% endif %}{% if not loop.last %} & {% endif %}{% endfor %} \\
{% endfor %}
\end{longtable}
}
{%- else -%}
\begin{table}[{% if table.rows | length > 10 %}tbp{% else %}H{% endif %}]
\centering
\footnotesize
\caption{ {{ table.caption }} Source: {{ table.source.run_id }}/{{ table.source.artifact }}{% if table.source.checkpoint %}; checkpoint {{ table.source.checkpoint }}{% endif %}. }
\label{tab:{{ table.id }}}
{% set spec = table | column_spec %}
{# Shrink only when every column is short. A table with a wrapping p{} column already
   fits the line width, and resizing it as well is what rendered the declared-contrast
   table at a fifth of body size. #}
{% if "p{" not in spec and table.columns | length > 2 %}\resizebox{\ifdim\width>0.98\linewidth 0.98\linewidth\else\width\fi}{!}{
{% endif %}
\begin{tabular}{ {{ spec }} }
\toprule
{{ table.columns | join(" & ") }} \\
\midrule
{% for row in table.rows %}
{% for cell in row %}{% if cell.bold_text %}{{ cell.text | replace(cell.bold_text, "\\textbf{" ~ cell.bold_text ~ "}") }}{% elif cell.bold %}\textbf{ {{ cell.text }} }{% else %}{{ cell.text }}{% endif %}{% if not loop.last %} & {% endif %}{% endfor %} \\
{% endfor %}
\bottomrule
\end{tabular}
{% if "p{" not in spec and table.columns | length > 2 %}}{% endif %}
{% if table.note %}\par\footnotesize\emph{Note.} {{ table.note }}{% endif %}
\end{table}
{%- endif %}
{%- endmacro %}

{% macro render_figure(figure, id="figure") -%}
\begin{figure}[H]
\centering
\includegraphics[width=\linewidth]{ {{ figure.path }} }
\caption{ {{ figure.caption.rstrip('.') }}.}
\label{fig:{{ id }}}
\end{figure}
{%- endmacro %}

\begin{document}
\maketitle

{% for section in manuscript_sections %}
{% if section.id == "abstract" %}
\begin{abstract}
{% for block in section.blocks %}{% if block.kind == "paragraph" %}{{ block.text }}

{% endif %}{% endfor %}
\end{abstract}
{% else %}
\section{ {{ section.title }} }
\label{sec:{{ section.id }}}
{% for block in section.blocks %}
{% if block.kind == "paragraph" %}{{ block.text }}

{% elif block.kind == "table" %}{{ render_table(block.table) }}
{% elif block.kind == "figure" %}{{ render_figure(block.figure, block.id) }}
{% endif %}
{% endfor %}
{% endif %}
{% if section.id == "introduction" and related_work %}
\section{Related Work}
\label{sec:related_work}
{{ related_work }}
{% endif %}
{% endfor %}
{% if appendix %}
\appendix
\section{Supplementary diagnostics}
{% for block in appendix %}
{% if block.kind == "table" %}{{ render_table(block.table) }}
{% elif block.kind == "figure" %}{{ render_figure(block.figure, block.id) }}
{% endif %}
{% endfor %}
{% endif %}
{% if references_bib %}
\clearpage
\bibliographystyle{plainnat}
\bibliography{references}
{% endif %}


\end{document}
